# Shopify OAuth Integration - Environment Variables
# 
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env file to git!

# ===== Shopify App Credentials =====
# Get these from: https://partners.shopify.com
# 1. Create an app in Shopify Partners
# 2. Navigate to "Configuration" 
# 3. Copy from "Admin API credentials" section

SHOPIFY_CLIENT_ID=your_shopify_client_id_here
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret_here

# ===== OAuth Configuration =====
# Must match your Shopify app settings exactly!

# Development (localhost)
REDIRECT_URI=http://localhost:9000/oauth/shopify/callback

# Production (change to your domain)
# REDIRECT_URI=https://your-domain.com/oauth/shopify/callback

# ===== Chatbot Widget =====
# URL to your chatbot widget script
# This gets injected into customer stores

CHATBOT_WIDGET_URL=https://your-domain.com/chatbot-widget.js

# For development, you can use:
# CHATBOT_WIDGET_URL=http://localhost:9000/chatbot-widget.js

# ===== Server Configuration =====
PORT=9000
NODE_ENV=development

# ===== Database Configuration =====
# If using Appwrite

APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id
APPWRITE_API_KEY=your_api_key
APPWRITE_DATABASE_ID=your_database_id

# ===== Logging =====
LOG_LEVEL=debug

# ===== Security =====
# JWT secret for securing connections (generate with: openssl rand -hex 32)
JWT_SECRET=your_secret_key_here_change_in_production

# HMAC secret (usually same as SHOPIFY_CLIENT_SECRET)
WEBHOOK_SECRET=your_webhook_secret_here

# ===== Feature Flags =====
ENABLE_TEST_MODE=true
ENABLE_WEBHOOKS=true
AUTO_INSTALL_WIDGET=true

# ===== Email Configuration (optional) =====
# For sending notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
NOTIFICATION_EMAIL=support@your-domain.com

# ===== API Rate Limiting =====
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# ===== Monitoring (optional) =====
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
ANALYTICS_KEY=your_analytics_key_here

# ===== Custom Settings =====
# App name shown to customers
APP_NAME=AI Chatbot SaaS

# Support contact
SUPPORT_EMAIL=support@your-domain.com

# Default chatbot settings
CHATBOT_LANGUAGE=en
CHATBOT_THEME=light
